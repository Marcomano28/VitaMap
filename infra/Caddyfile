# =====================================================================
# VitaMap — Caddy 2
# TLS automático vía Let's Encrypt. Apunta DNS A/AAAA al VPS antes de up.
# =====================================================================

{
	# Email para avisos de Let's Encrypt. Cambiar antes de producción.
	email {$CADDY_EMAIL:admin@vitamap.local}

	# Endurecer: deshabilitar admin API en producción.
	admin off
}

# Dominio principal — pasar por variable de entorno PUBLIC_DOMAIN.
{$PUBLIC_DOMAIN:localhost} {
	encode zstd gzip

	# Cabeceras de seguridad.
	# CSP: Next.js App Router necesita 'unsafe-inline' en script/style
	# (scripts de bootstrap inline sin nonce). No se carga JS de terceros:
	# el checkout de Stripe es por redirección, de ahí form-action incluye
	# checkout.stripe.com (los navegadores aplican form-action también a
	# las redirecciones tras enviar un formulario).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# /api/health no requiere auth ni logging detallado.
	@health path /api/health
	handle @health {
		reverse_proxy web:3000
	}

	# Resto de la app.
	reverse_proxy web:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
