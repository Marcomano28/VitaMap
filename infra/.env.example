# =====================================================================
# VitaMap — infra/.env.example
# Variables que lee docker-compose en el VPS (Fase 1). Copiar a infra/.env
# y rellenar antes del primer `docker compose up`.
# NUNCA commitear infra/.env.
# =====================================================================

# --- Dominio y TLS ---------------------------------------------------
# Apuntar DNS A (y AAAA si IPv6) al VPS antes de levantar Caddy.
PUBLIC_DOMAIN=vitamap.example.com
PUBLIC_URL=https://vitamap.example.com
CADDY_EMAIL=admin@vitamap.example.com

# --- Modelo LLM principal -------------------------------------------
# Dos modos (ADR-014). El perfil compose "local-llm" controla si se
# levanta el contenedor llama.cpp.
#
# MODO A — local (blindaje final / por defecto):
COMPOSE_PROFILES=local-llm
LLM_PROVIDER=local
# El fichero debe existir en el volumen llm_models (download-model.sh).
LLM_MODEL=qwen3-4b-instruct
LLM_MODEL_FILE=qwen3-4b-instruct-q4_k_m.gguf
LLM_API_KEY=not-needed-for-local
LLM_THREADS=2
#
# MODO B — API externa UE durante el piloto (ADR-014). Requisitos previos:
# opt-out de entrenamiento en el Admin Console del proveedor, ZDR si está
# disponible, y consentimiento explícito de los usuarios piloto.
# Descomentar y comentar el bloque del MODO A:
# COMPOSE_PROFILES=
# LLM_PROVIDER=external
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest
# LLM_API_KEY=replace_with_mistral_api_key

# --- Modelo de embeddings de QMD (multilingüe fijado desde día uno) -
QMD_EMBED_MODEL=hf:Qwen/Qwen3-Embedding-0.6B-GGUF/Qwen3-Embedding-0.6B-Q8_0.gguf

# --- Secretos de aplicación -----------------------------------------
# Generar con: openssl rand -hex 32
MASTER_KEY=replace_with_64_hex_chars
BETTER_AUTH_SECRET=replace_with_64_hex_chars

# --- Administración del corpus --------------------------------------
# Lista de correos BetterAuth autorizados, separados por comas.
ADMIN_EMAILS=admin@vitamap.example.com

# --- Interruptores de módulo (piloto, requisito B.1) ----------------
# Cuestionarios/escalas en /assess (PHQ-9, GAD-7 y constitución/prakriti).
# APAGADO por defecto: solo se activan con el valor exacto "true", una vez
# completada la revisión por módulo de la sección B. Cualquier otro valor
# (o ausencia) los mantiene ocultos y bloquea sus páginas y su guardado.
ASSESSMENTS_ENABLED=false

# Guía educativa del asistente: ante un valor fuera de rango o una petición de
# consejo, explica el marcador en general (con fuentes citadas) como preparación
# para el especialista, sin interpretar el resultado personal. Es una función
# interpretativa; mantener "false" hasta la revisión por módulo de la sección B.
ASSISTANT_EDU_GUIDE=false

# Acotación de la KB compartida por marcador: filtra los documentos al
# marcador en juego (analítica del usuario + pregunta) para que no se cuele
# uno de otro marcador. "true" para activar; validar en el VPS antes de fijar.
KB_MARKER_SCOPE=false

# Diagnóstico de retrieval (query + títulos/scores de chunks en logs).
# Contiene contenido de usuario: activar solo durante depuración puntual.
RETRIEVAL_DEBUG=false

# --- Email transaccional (Brevo, UE) --------------------------------
# Verificación de email y recuperación de contraseña. Crear API key en
# app.brevo.com → SMTP & API. Verificar el dominio/remitente en Brevo
# antes del primer envío. Son obligatorias para el servicio web en producción.
BREVO_API_KEY=xkeysib-replace
EMAIL_FROM="VitaMap <no-reply@vitamap.example.com>"
# Buzón real opcional para respuestas de soporte.
EMAIL_REPLY_TO=support@vitamap.example.com

# --- Backups (restic + Backblaze B2) --------------------------------
# Crear bucket en B2 EU. Generar credenciales application keys con acceso
# limitado al bucket.
RESTIC_REPOSITORY=sftp:storagebox:vitamap-backups
RESTIC_PASSWORD=replace_with_strong_passphrase
# La autenticación con la Storage Box es por clave SSH, no por variables
# de entorno: ver infra/ssh/storagebox_config y el servicio "backup" en
# docker-compose.yml (monta /root/.ssh/storagebox_ed25519 y known_hosts).

# --- Stripe Billing -------------------------------------------------
STRIPE_SECRET_KEY=sk_live_replace
STRIPE_PUBLISHABLE_KEY=pk_live_replace
STRIPE_PRICE_ID=price_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
