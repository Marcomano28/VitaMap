# =====================================================================
# VitaMap — variables de entorno (Fase 0 / Fase 1)
# Copia este archivo a .env y rellena los valores. NO commitees .env.
# =====================================================================

# --- LLM principal (Qwen3-4B local vía llama.cpp server) ---
# Endpoint compatible con OpenAI. En desarrollo local lo levanta llama.cpp.
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen3-4b-instruct
LLM_API_KEY=not-needed-for-local

# --- Modelo de embeddings de QMD (multilingüe, fijado desde el día uno) ---
# Forzar Qwen3-Embedding evita reindexar al añadir voluntarios en español.
QMD_EMBED_MODEL=hf:Qwen/Qwen3-Embedding-0.6B-GGUF/Qwen3-Embedding-0.6B-Q8_0.gguf

# --- Rutas de datos ---
# En local, las rutas relativas se resuelven respecto a este archivo .env,
# no respecto al directorio desde el que npm o Next ejecuten el proceso.
# En Fase 1 (VPS), Docker usa rutas absolutas bajo /data.
DATA_ROOT=./data
KB_INDEX_PATH=./data/kb-index.sqlite
AUTH_DB_PATH=./data/auth.sqlite

# --- Master key para cifrado de campos sensibles y PDFs (age) ---
# Generar con: openssl rand -hex 32
# IMPORTANTE: rotable. Guardar copia offline cifrada.
MASTER_KEY=replace_with_64_hex_chars

# --- BetterAuth ---
# Generar con: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_64_hex_chars
BETTER_AUTH_URL=http://localhost:3000

# --- Email transaccional (Brevo) ---
BREVO_API_KEY=xkeysib-replace
EMAIL_FROM="VitaMap <no-reply@vitamap.example.com>"
EMAIL_REPLY_TO=support@vitamap.example.com

# --- Administración del corpus ---
# Lista de correos BetterAuth autorizados, separados por comas.
ADMIN_EMAILS=admin@example.com

# --- Asistente: guía educativa (opcional, desactivable) ---
# Ante un valor fuera de rango o una petición de consejo, explica el marcador
# en general (con fuentes citadas) como preparación para el especialista, sin
# interpretar el resultado personal. Función interpretativa: mantener "false"
# hasta la revisión por módulo de la sección B de la guía operativa.
ASSISTANT_EDU_GUIDE=false

# --- Hosting / app ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
